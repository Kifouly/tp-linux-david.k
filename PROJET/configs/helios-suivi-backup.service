[Unit]
Description=Helios - sauvegarde du portail de suivi

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/helios-suivi-backup.sh
Nice=10
IOSchedulingClass=idle

# root mais seule la destination est inscriptible
ProtectSystem=strict
ReadWritePaths=/srv/helios/archives/suivi
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
# lire les fichiers des autres comptes (www, sudoers) sans autre privilege
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
