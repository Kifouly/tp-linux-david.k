[Unit]
Description=Helios - publication de etat.json pour le portail de suivi
After=helios-collect.service

[Service]
Type=oneshot
User=helios-suivi
Group=helios-suivi
ExecStart=/usr/local/sbin/helios-suivi-publish.sh

# seul www est inscriptible
ProtectSystem=strict
ReadWritePaths=/srv/helios/suivi/www
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
